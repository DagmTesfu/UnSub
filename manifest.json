{
  "manifest_version": 3,
  "name": "UnSub",
  "version": "1.0.0",
  "description": "Track subscription domain visits to identify unused services and save money.",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
